{
  "name": "vb6-lsp",
  "displayName": "VB6 Language Server",
  "description": "VB6 LSP and MCP analysis for .vbp projects (.bas, .cls, .frm, .ctl)",
  "version": "3.4.0",
  "publisher": "vb6lsp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Agwstin/vb6-lsp.git"
  },
  "homepage": "https://github.com/Agwstin/vb6-lsp#readme",
  "bugs": {
    "url": "https://github.com/Agwstin/vb6-lsp/issues"
  },
  "icon": "images/icon.png",
  "engines": {
    "node": ">=22.0.0",
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "galleryBanner": {
    "color": "#1f6feb",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:vb6"
  ],
  "main": "./out/client/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vb6",
        "aliases": [
          "Visual Basic 6",
          "VB6"
        ],
        "extensions": [
          ".bas",
          ".cls",
          ".frm",
          ".ctl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vb6",
        "scopeName": "source.vb6",
        "path": "./syntaxes/vb6.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "VB6 LSP",
      "properties": {
        "vb6.sourcePaths": {
          "type": "array",
          "default": [],
          "description": "Additional source directories to index. Relative paths are resolved from the workspace root."
        },
        "vb6.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "Override the workspace root used to resolve .vbp files and source directories."
        },
        "vb6.projectFiles": {
          "type": "array",
          "default": [],
          "description": "Optional list of .vbp files to parse. Relative paths are resolved from the workspace root."
        },
        "vb6.preferProjectFiles": {
          "type": "boolean",
          "default": true,
          "description": "Prefer .vbp discovery over static sourcePaths when both are available."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "build:all": "npm run build && npm run build:mcp",
    "lsp:stdio": "node out/server/server.js --stdio",
    "mcp:stdio": "node out/mcp/mcp/server.js",
    "benchmark": "npm run build:all && node scripts/benchmark-vs-grep.mjs",
    "benchmark:core": "node scripts/benchmark-core.mjs",
    "benchmark:rescue": "node scripts/benchmark-rescue.mjs",
    "verify:package": "node scripts/verify-package-config.mjs",
    "verify:package:built": "node scripts/verify-package-config.mjs --require-built",
    "telemetry:report": "node scripts/telemetry-report.mjs",
    "package:vsix": "npm run verify:package:built && npx @vscode/vsce package",
    "test": "npm run build:all && node scripts/run-tests.mjs",
    "watch": "concurrently \"tsc -w -p tsconfig.json\" \"tsc -w -p tsconfig.server.json\"",
    "postinstall": "cd . && echo Done"
  },
  "keywords": [
    "vb6",
    "visual-basic-6",
    "lsp",
    "language-server",
    "mcp",
    "legacy",
    "visual-basic",
    "vscode-extension",
    "code-navigation",
    "static-analysis",
    "ai-coding"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-uri": "^3.0.8",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
